# ── Provider selection ─────────────────────────────────────
# Options: groq (default, free tier) | claude | openai | ollama
PROVIDER=groq

# ── Groq (free tier — sign up at console.groq.com) ─────────
GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ── Claude (optional, BYOK) ────────────────────────────────
# PROVIDER=claude
# ANTHROPIC_API_KEY=sk-ant-your_key_here
# ANTHROPIC_MODEL=claude-sonnet-4-6

# ── OpenAI or any OpenAI-compatible endpoint ───────────────
# PROVIDER=openai
# OPENAI_API_KEY=sk-your_key_here
# OPENAI_BASE_URL=            # leave empty for api.openai.com
# OPENAI_MODEL=gpt-4o-mini

# ── Local models via Ollama (free, offline) ────────────────
# PROVIDER=ollama
# OPENAI_MODEL=llama3.2

# ── Force a context window for unknown models (optional) ───
# CONTEXTIQ_CONTEXT_WINDOW=1000000
